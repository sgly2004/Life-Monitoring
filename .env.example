# ── LLM Integration (optional) ──────────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will NOT be committed.
#
# Without LLM_API_KEY, the pipeline still runs and plots timeline points using
# the facettd model output directly (remaining_life_median ± 50% uncertainty).
#
# With LLM_API_KEY, all module results are synthesized by the LLM into a more
# nuanced remaining-life estimate with key factors and a summary paragraph.

# API key for any OpenAI-compatible service (OpenAI, DeepSeek, Moonshot, etc.)
LLM_API_KEY=

# Base URL of the OpenAI-compatible API (default: OpenAI)
# Examples:
#   https://api.openai.com/v1          (OpenAI)
#   https://api.deepseek.com/v1        (DeepSeek)
#   https://api.moonshot.cn/v1         (Moonshot / Kimi)
LLM_API_BASE=https://api.openai.com/v1

# Model name to use for lifetime estimation
LLM_MODEL=gpt-4o
